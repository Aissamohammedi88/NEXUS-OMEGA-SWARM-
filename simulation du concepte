        #status { color: var(--green); font-size: 0.9rem; }
        
        .grid { flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 15px; padding: 15px; height: calc(100vh - 120px); }
        
        .panel { background: rgba(10, 15, 25, 0.8); border: 1px solid #1a2333; border-radius: 8px; padding: 15px; display: flex; flex-direction: column; overflow-y: auto; }
        .panel h2 { font-size: 0.8rem; color: #888; border-bottom: 1px solid #333; padding-bottom: 5px; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 1px; }
        
        .log-entry { margin-bottom: 8px; font-size: 0.85rem; line-height: 1.4; padding: 6px; border-radius: 4px; background: rgba(0,0,0,0.3); border-left: 3px solid #333; }
        .log-entry.planner { border-color: var(--cyan); }
        .log-entry.coder { border-color: var(--magenta); }
        .log-entry.executor { border-color: var(--orange); }
        .log-entry.reflector { border-color: var(--green); }
        
        .log-entry .agent { font-weight: bold; margin-right: 8px; }
        .planner .agent { color: var(--cyan); }
        .coder .agent { color: var(--magenta); }
        .executor .agent { color: var(--orange); }
        .reflector .agent { color: var(--green); }

        /* Canvas pour le graphe */
        #graph-canvas { width: 100%; height: 100%; }
    </style>
</head>
<body>
    <header>
        <h1>🧬 NEXUS OMEGA SWARM // LIVE</h1>
        <div id="status">● CONNEXION...</div>
    </header>
    
    <div class="grid">
        <div class="panel">
            <h2>Terminal des Agents</h2>
            <div id="logs"></div>
        </div>
        <div class="panel" style="position:relative">
            <h2>Graphe d'Orchestration</h2>
            <canvas id="graph-canvas"></canvas>
        </div>
    </div>

    <script>
        const logs = document.getElementById('logs');
        const status = document.getElementById('status');
        const canvas = document.getElementById('graph-canvas');
        const ctx = canvas.getContext('2d');

        // Redimensionnement Canvas
        function resize() {
            canvas.width = canvas.offsetWidth;
            canvas.height = canvas.offsetHeight;
        }
        window.addEventListener('resize', resize); resize();

        // WebSocket (simulé ici via fetch polling ou WebSocket si supporté)
        // Pour la simplicité du script bash, on utilise Server-Sent Events (SSE)
        const evtSource = new EventSource("http://localhost:9003/stream");
        
        evtSource.onopen = () => {
            status.textContent = "● EN LIGNE";
            status.style.color = "var(--green)";
        };

        evtSource.onerror = () => {
            status.textContent = "● DÉCONNECTÉ";
            status.style.color = "var(--red)";
        };

        evtSource.onmessage = (event) => {
            const data = JSON.parse(event.data);
            addLog(data.agent, data.message);
            animateAgent(data.agent);
        };

        function addLog(agent, msg) {
            const div = document.createElement('div');
            div.className = `log-entry ${agent.toLowerCase()}`;
            const time = new Date().toLocaleTimeString();
            div.innerHTML = `<span class="agent">[${agent}]</span> <span style="color:#666;font-size:0.75rem">${time}</span><br>${msg}`;
            logs.appendChild(div);
            logs.scrollTop = logs.scrollHeight;
        }

        // --- ANIMATION DU GRAPHE ---
        const nodes = {
            'Planner':  { x: canvas.width/2, y: 50, color: '#00f3ff' },
            'Coder':    { x: canvas.width/2, y: 150, color: '#ff00ea' },
            'Executor': { x: canvas.width/2, y: 250, color: '#ffb800' },
            'Reflector':{ x: canvas.width/2, y: 350, color: '#00ff9d' }
        };

        let activeNode = null;

        function animateAgent(agent) {
            activeNode = agent;
            drawGraph();
        }

        function drawGraph() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            // Dessiner les lignes
            ctx.beginPath();
            ctx.strokeStyle = '#333';
            ctx.lineWidth = 2;
            ctx.moveTo(canvas.width/2, 50);
            ctx.lineTo(canvas.width/2, 150);
            ctx.lineTo(canvas.width/2, 250);
            ctx.lineTo(canvas.width/2, 350);
            ctx.stroke();

            // Dessiner les nœuds
            Object.keys(nodes).forEach(name => {
                const n = nodes[name];
                ctx.beginPath();
                ctx.arc(n.x, n.y, 25, 0, Math.PI * 2);
                ctx.fillStyle = (activeNode === name) ? n.color : '#111';
                ctx.fill();
                ctx.strokeStyle = n.color;
                ctx.lineWidth = 2;
                ctx.stroke();

                ctx.fillStyle = (activeNode === name) ? '#000' : n.color;
                ctx.font = 'bold 12px Courier New';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(name, n.x, n.y);
            });
        }

        // Init graph
        setTimeout(() => { resize(); drawGraph(); }, 100);
    </script>
</body>
</html>
HTML_EOF

