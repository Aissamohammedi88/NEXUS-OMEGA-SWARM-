cat << 'HTML_EOF' > "$WORK_DIR/index.html"
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>NEXUS Swarm - Live Simulation</title>
    <style>
        :root { --bg: #050810; --cyan: #00f3ff; --magenta: #ff00ea; --green: #00ff9d; --orange: #ffb800; --text: #e0f7fa; }
        * { box-sizing: border-box; font-family: 'Courier New', monospace; margin: 0; padding: 0; }
