class NexusCLI:
"""
Interface en ligne de commande pour interagir avec le swarm.
"""

def __init__(self):
self.orchestrator = NexusOrchestrator()
self.running = True

def display_banner(self):
"""Affiche la bannière de démarrage."""
print("")
print("=" * 70)
print(f"🔥 NEXUS OMEGA SWARM v{NexusConfig.VERSION}")
print(f"👑 Architecte : {NexusConfig.ARCHITECTE}")
print(f"👑 Héritier : {NexusConfig.HERITIER}")
print("=" * 70)
print("Commandes spéciales :")
print(" /help - Afficher l'aide")
print(" /stats - Statistiques de la mémoire")
print(" /clean - Nettoyer le sandbox")
print(" /exit - Quitter")
print("=" * 70)
print("")

def display_help(self):
"""Affiche l'aide."""
print("\n📖 AIDE NEXUS OMEGA SWARM")
print("-" * 70)
print("Entrez une requête en langage naturel.")
print("Le swarm va :")
print(" 1. Planifier les tâches nécessaires")
print(" 2. Générer le code Python pour chacune")
print(" 3. Exécuter le code en sandbox")
print(" 4. Corriger les erreurs automatiquement (max 3 tentatives)")
print(" 5. Mémoriser les succès pour l'apprentissage futur")
print("-" * 70)
print("Commandes :")
print(" /help - Cette aide")
print(" /stats - Statistiques mémoire")
print(" /clean - Nettoyer le sandbox")
print(" /exit - Quitter")
print("-" * 70 + "\n")

def display_stats(self):
"""Affiche les statistiques."""
stats = self.orchestrator.memory.get_stats()
print(f"\n📊 STATISTIQUES")
print(f" Statut mémoire : {stats['status']}")
print(f" Entrées : {stats['count']}")
print(f" Sandbox : {NexusConfig.SANDBOX_DIR}")
print(f" Logs : {NexusConfig.LOG_DIR}\n")

def cleanup(self):
"""Nettoie le sandbox."""
SecuritySandbox.cleanup_sandbox()
print("✅ Sandbox nettoyé.\n")

async def run(self):
"""Boucle principale de l'interface."""
self.display_banner()

while self.running:
try:
user_input = input("👑 Héritier > ").strip()

if not user_input:
continue

# Commandes spéciales
if user_input.startswith("/"):
command = user_input.lower()

if command == "/exit" or command == "/quit":
logger.info("Arrêt du système. Au revoir, Héritier.")
self.running = False
break

elif command == "/help":
self.display_help()

elif command == "/stats":
self.display_stats()

elif command == "/clean":
self.cleanup()

else:
print(f"❌ Commande inconnue : {user_input}")
print("Tapez /help pour l'aide.\n")

continue

# Exécution de la requête
await self.orchestrator.run_swarm(user_input)

except KeyboardInterrupt:
print("\n\n⚠️ Interruption détectée.")
logger.info("Arrêt demandé par l'utilisateur.")
self.running = False
break

except EOFError:
logger.info("EOF reçu. Arrêt.")
self.running = False
break

except Exception as e:
logger.error(f"Erreur inattendue : {e}")
logger.debug(traceback.format_exc())
print(f"❌ Erreur : {e}\n")

# ==============================================================================
# SECTION 11 : POINT D'ENTRÉE
# ==============================================================================

async def main():
"""Fonction principale asynchrone."""

# Vérification Python
if sys.version_info < (3, 10):
logger.error(f"Python 3.10+ requis. Version actuelle : {sys.version}")
sys.exit(1)

# Vérification Ollama
try:
ollama.list()
except Exception:
logger.error("Ollama n'est pas accessible. Lancez : ollama serve")
sys.exit(1)

# Lancement de l'interface
cli = NexusCLI()
await cli.run()

if __name__ == "__main__":
try:
asyncio.run(main())
except KeyboardInterrupt:
logger.info("\nArrêt propre du système.")
sys.exit(0)
except Exception as e:
logger.error(f"Erreur fatale : {e}")
logger.debug(traceback.format_exc())
sys.exit(1)
