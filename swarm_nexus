self._check_ollama()

# Initialisation des composants
logger.info("Initialisation des composants...")
self.llm = ChatOllama(
model=NexusConfig.LLM_MODEL,
temperature=0,
num_ctx=4096
)
self.memory = NexusMemory()

# Instanciation des agents
self.agents = {
"planner": PlannerAgent(self.llm),
"coder": CoderAgent(self.llm, self.memory),
"executor": ExecutorAgent(),
"reflector": ReflectorAgent(self.memory)
}

# Construction du graphe
logger.info("Construction du graphe d'orchestration...")
self.graph = self._build_graph()

logger.info("✅ Orchestrateur prêt.")
logger.info("=" * 70)

def _check_ollama(self):
"""Vérifie la connexion Ollama."""
try:
ollama.list()
logger.info("✅ Connexion Ollama établie.")
except Exception as e:
logger.error(f"❌ Impossible de se connecter à Ollama : {e}")
logger.error("Assurez-vous qu'Ollama est lancé : ollama serve")
logger.error(f"Et que les modèles sont installés :")
logger.error(f" ollama pull {NexusConfig.LLM_MODEL}")
logger.error(f" ollama pull {NexusConfig.EMBED_MODEL}")
sys.exit(1)

def _build_graph(self) -> StateGraph:
"""Construit le graphe avec les nœuds et les transitions."""
workflow = StateGraph(AgentState)

# Ajout des nœuds
for name, agent in self.agents.items():
workflow.add_node(name, agent.run)

# Point d'entrée
workflow.set_entry_point("planner")

# Transitions simples
workflow.add_edge("planner", "coder")
workflow.add_edge("coder", "executor")
workflow.add_edge("executor", "reflector")

# Transition conditionnelle depuis le réflecteur
def route_after_reflection(state: AgentState) -> str:
status = state.get("status", "")

if status == "DONE":
return END
elif status == "FAILED":
return END
elif status == "CODING":
return "coder"
else:
logger.warning(f"Statut inconnu : {status}, arrêt.")
return END

workflow.add_conditional_edges(
"reflector",
route_after_reflection,
{
"coder": "coder",
END: END
}
)

logger.info("✅ Graphe compilé.")
return workflow.compile()

async def run_swarm(self, user_request: str) -> Dict[str, Any]:
"""
Lance le cycle complet du swarm.
Retourne un dictionnaire avec le résultat final.
"""
logger.info("")
logger.info("=" * 70)
logger.info(f"🔥 NOUVELLE REQUÊTE")
logger.info(f" {user_request[:200]}")
logger.info("=" * 70)

# État initial
initial_state: AgentState = {
"messages": [HumanMessage(content=user_request)],
"task_queue": [],
"current_task": None,
"generated_code": None,
"execution_output": None,
"error_trace": None,
"retry_count": 0,
"status": "PLANNING",
"history": [],
"task_index": 0
}

# Exécution du graphe
final_state = None
start_time = time.time()

try:
async for event in self.graph.astream(initial_state):
for node_name, state_update in event.items():
logger.debug(f"--- Nœud : {node_name} ---")

if state_update:
for key, value in state_update.items():
if key in ["status", "current_task", "retry_count"]:
logger.debug(f" {key} = {value}")

final_state = state_update

except Exception as e:
logger.error(f"Erreur critique swarm : {e}")
logger.debug(traceback.format_exc())
return {
"success": False,
"error": str(e),
"duration": time.time() - start_time
}

# Nettoyage
SecuritySandbox.cleanup_sandbox()

# Rapport final
duration = time.time() - start_time

logger.info("")
logger.info("=" * 70)
logger.info("📊 RAPPORT FINAL DU SWARM")
logger.info("=" * 70)
logger.info(f"Durée totale : {duration:.2f}s")

success = final_state and final_state.get("status") == "DONE"

if success:
logger.info("🎉 SUCCÈS : La requête a été accomplie.")
if final_state.get("execution_output"):
output = final_state["execution_output"]
logger.info(f"Dernière sortie ({len(output)} chars) :")
logger.info(output[:1000])
else:
logger.error("💥 ÉCHEC : La requête n'a pas pu être accomplie.")
if final_state and final_state.get("error_trace"):
logger.error(f"Erreur : {final_state['error_trace'][:500]}")

memory_stats = self.memory.get_stats()
logger.info(f"Mémoire : {memory_stats['count']} entrées")
logger.info("=" * 70)

return {
"success": success,
"final_state": final_state,
"duration": duration,
"memory_stats": memory_stats
}

