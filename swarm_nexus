class SecuritySandbox:
"""
Environnement d'exécution sécurisé.
"""

@staticmethod
def execute_code(code: str, timeout: int = NexusConfig.EXECUTION_TIMEOUT) -> Dict[str, Any]:
"""
Exécute le code dans un sous-processus isolé.
"""
# Validation préalable
is_safe, error = SecurityValidator.validate_code(code)
if not is_safe:
return {
"success": False,
"output": "",
"error": f"Code refusé par le validateur : {error}",
"execution_time": 0
}

# Fichier temporaire dans le sandbox
timestamp = int(time.time() * 1000)
temp_file = os.path.join(NexusConfig.SANDBOX_DIR, f"exec_{timestamp}.py")

start_time = time.time()

try:
# Écriture du code
with open(temp_file, "w", encoding="utf-8") as f:
f.write(code)

logger.info(f"⚙️ Exécution code (timeout={timeout}s)...")

# Exécution sécurisée
result = subprocess.run(
[sys.executable, temp_file],
capture_output=True,
text=True,
timeout=timeout,
cwd=NexusConfig.SANDBOX_DIR,
check=False
)

execution_time = time.time() - start_time

if result.returncode == 0:
return {
"success": True,
"output": result.stdout,
"error": None,
"execution_time": execution_time
}
else:
return {
"success": False,
"output": result.stdout,
"error": result.stderr,
"execution_time": execution_time
}

except subprocess.TimeoutExpired:
return {
"success": False,
"output": "",
"error": f"TimeoutError: Exécution > {timeout}s",
"execution_time": time.time() - start_time
}

except Exception as e:
return {
"success": False,
"output": "",
"error": f"ExecutionError: {str(e)}",
"execution_time": time.time() - start_time
}

finally:
if os.path.exists(temp_file):
try:
os.remove(temp_file)
except OSError:
pass

@staticmethod
def cleanup_sandbox():
"""Nettoie le répertoire sandbox."""
try:
for file in os.listdir(NexusConfig.SANDBOX_DIR):
file_path = os.path.join(NexusConfig.SANDBOX_DIR, file)
if os.path.isfile(file_path) and file.startswith("exec_"):
os.remove(file_path)
logger.debug("Sandbox nettoyé.")
except Exception as e:
logger.error(f"Erreur nettoyage sandbox : {e}")

