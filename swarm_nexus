class SecurityValidator:
"""
Valide le code généré avant exécution.
"""

@staticmethod
def check_forbidden_patterns(code: str) -> Tuple[bool, Optional[str]]:
"""
Vérifie les patterns dangereux dans le code.
Retourne (is_safe, error_message).
"""
for pattern in NexusConfig.FORBIDDEN_PATTERNS:
if re.search(pattern, code, re.IGNORECASE):
return False, f"Pattern interdit détecté : {pattern}"

return True, None

@staticmethod
def check_imports(code: str) -> Tuple[bool, Optional[str]]:
"""
Vérifie que tous les imports sont autorisés.
"""
import_pattern = r"^\s*(?:import|from)\s+(\w+)"
matches = re.findall(import_pattern, code, re.MULTILINE)

for module in matches:
if module not in NexusConfig.ALLOWED_IMPORTS:
return False, f"Import non autorisé : {module}"

return True, None

@staticmethod
def validate_code(code: str) -> Tuple[bool, Optional[str]]:
"""
Validation complète du code.
"""
if not code or not code.strip():
return False, "Code vide"

# Vérifier les patterns dangereux
safe, error = SecurityValidator.check_forbidden_patterns(code)
if not safe:
return False, error

# Vérifier les imports
safe, error = SecurityValidator.check_imports(code)
if not safe:
return False, error

return True, None

class CodeCleaner:
"""
Nettoie le code généré par le LLM.
"""

@staticmethod
def extract_code(text: str) -> str:
"""
Extrait le code Python depuis une réponse Markdown.
"""
# Pattern pour les blocs de code Python
patterns = [
r"```python\s*\n(.*?)```",
r"```\s*\n(.*?)```",
r"```python(.*?)```",
]

for pattern in patterns:
match = re.search(pattern, text, re.DOTALL)
if match:
return match.group(1).strip()

# Si pas de bloc, retourner le texte brut (supposition que c'est du code)
lines = text.split('\n')
code_lines = []
in_code = False

for line in lines:
if line.strip().startswith(('import ', 'from ', 'def ', 'class ', '#', '"""', "'''")):
in_code = True
if in_code:
code_lines.append(line)

if code_lines:
return '\n'.join(code_lines)

return text.strip()

@staticmethod
def remove_comments(code: str) -> str:
"""
Supprime les commentaires excessifs (optionnel).
"""
lines = code.split('\n')
cleaned = []
for line in lines:
if not line.strip().startswith('#'):
cleaned.append(line)
return '\n'.join(cleaned)

