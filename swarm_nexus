class PlannerAgent(BaseAgent):
"""
Décompose la requête utilisateur en tâches séquentielles.
"""

def __init__(self, llm: ChatOllama):
super().__init__("Planner", "Décompose les requêtes en tâches")
self.llm = llm

async def run(self, state: AgentState) -> Dict[str, Any]:
self._log_step("Analyse de la requête...")

user_request = state["messages"][-1].content

prompt = f"""Tu es le Planificateur Suprême de NEXUS OMEGA.
Ta mission : décomposer la requête de l'Héritier en une liste de tâches techniques.
Chaque tâche doit être :
- Atomique (une seule action)
- Exécutable en Python
- Séquentielle (dépend de la précédente)
- Claires et sans ambiguïté

RÈGLES :
- Maximum {NexusConfig.MAX_TASKS} tâches
- Réponds UNIQUEMENT avec la liste, une tâche par ligne
- Pas de numérotation, pas de texte explicatif
- Si la requête est déjà atomique, une seule tâche suffit

REQUÊTE : {user_request}

LISTE DES TÂCHES :"""

try:
response = await self.llm.ainvoke([SystemMessage(content=prompt)])

# Nettoyage des tâches
tasks = []
for line in response.content.split('\n'):
line = line.strip()
# Supprimer numérotation éventuelle
line = re.sub(r'^\d+[\.\)]\s*', '', line)
line = re.sub(r'^[-*]\s*', '', line)

if line and len(line) > 3:
tasks.append(line)

# Limite de sécurité
tasks = tasks[:NexusConfig.MAX_TASKS]

if not tasks:
tasks = [user_request]

self._log_step(f"Plan établi : {len(tasks)} tâche(s)")
for i, task in enumerate(tasks, 1):
logger.info(f" {i}. {task}")

return {
"task_queue": tasks,
"current_task": tasks[0],
"task_index": 0,
"status": "CODING",
"history": [{"step": "planning", "tasks": tasks, "timestamp": datetime.now().isoformat()}]
}

except Exception as e:
logger.error(f"Erreur planification : {e}")
logger.debug(traceback.format_exc())
return {
"status": "FAILED",
"error_trace": f"PlannerError: {str(e)}"
}

class CoderAgent(BaseAgent):
"""
Génère le code Python pour chaque tâche.
"""

def __init__(self, llm: ChatOllama, memory: NexusMemory):
super().__init__("Coder", "Génère le code Python")
self.llm = llm
self.memory = memory

async def run(self, state: AgentState) -> Dict[str, Any]:
task = state["current_task"]
retry = state.get("retry_count", 0)

self._log_step(f"Génération code pour '{task[:60]}...' (Tentative {retry + 1})")

# Contexte mémoire
memory_context = self.memory.retrieve_context(task)

# Contexte d'erreur si retry
error_context = ""
if state.get("error_trace"):
error_context = f"""
⚠️ ATTENTION : la tentative précédente a échoué.
ERREUR : {state['error_trace'][:1000]}
CODE PRÉCÉDENT :
{state.get('generated_code', '')[:1000]}

Corrige l'erreur dans le nouveau code.
"""

prompt = f"""Tu es un Développeur Python Senior de l'équipe NEXUS OMEGA.
Ta mission : écrire un script Python complet et fonctionnel.

CONTRAINTES STRICTES :
1. Le code doit être auto-suffisant (tous les imports inclus)
2. Pas de dépendances externes sauf : {', '.join(NexusConfig.ALLOWED_IMPORTS[:15])}
3. Gestion des erreurs avec try/except
4. Le code doit être exécutable tel quel
5. Pas de blabla, pas d'explications
6. Réponds avec UNIQUEMENT un bloc ```python

CONTEXTE MÉMOIRE (leçons du passé) :
{memory_context[:2000] if memory_context else "Aucune leçon applicable."}
{error_context}

TÂCHE À ACCOMPLIR :
{task}

CODE PYTHON :"""

try:
response = await self.llm.ainvoke([SystemMessage(content=prompt)])

# Extraction et nettoyage du code
code = CodeCleaner.extract_code(response.content)

if not code:
return {
"status": "FAILED",
"error_trace": "CoderError: Aucun code généré par le LLM"
}

self._log_step(f"Code généré : {len(code)} caractères")
logger.debug(f"Code généré :\n{code[:500]}...")

return {
"generated_code": code,
"status": "EXECUTING"
}

except Exception as e:
logger.error(f"Erreur génération code : {e}")
logger.debug(traceback.format_exc())
return {
"status": "FAILED",
"error_trace": f"CoderError: {str(e)}"
}

class ExecutorAgent(BaseAgent):
"""
Exécute le code généré dans le sandbox.
"""

def __init__(self):
super().__init__("Executor", "Exécute le code en sandbox")

async def run(self, state: AgentState) -> Dict[str, Any]:
self._log_step("Exécution du code...")

code = state.get("generated_code")

if not code:
return {
"status": "FAILED",
"error_trace": "ExecutorError: Aucun code à exécuter"
}

# Exécution sandbox
result = SecuritySandbox.execute_code(code)

if result["success"]:
self._log_step(f"✅ Exécution réussie ({result['execution_time']:.2f}s)")
logger.debug(f"Sortie :\n{result['output'][:500]}")

return {
"execution_output": result["output"],
"error_trace": None,
"status": "REFLECTING"
}
else:
self._log_step(f"❌ Échec exécution ({result['execution_time']:.2f}s)")
logger.warning(f"Erreur :\n{result['error'][:500]}")

return {
"execution_output": result["output"],
"error_trace": result["error"],
"status": "REFLECTING"
}

class ReflectorAgent(BaseAgent):
"""
Analyse le résultat et décide de la suite.
"""

def __init__(self, memory: NexusMemory):
super().__init__("Reflector", "Analyse et décide")
self.memory = memory

async def run(self, state: AgentState) -> Dict[str, Any]:
self._log_step("Analyse des résultats...")

task = state["current_task"]
code = state["generated_code"]
output = state.get("execution_output", "")
error = state.get("error_trace")

# Cas : SUCCÈS
if not error:
self._log_step(f"🎉 Tâche réussie : '{task[:60]}...'")

# Mémorisation
self.memory.store_success(task, code, output)

# Passer à la tâche suivante
remaining = state["task_queue"][1:]
current_index = state.get("task_index", 0) + 1

if remaining:
next_task = remaining[0]
self._log_step(f"➡️ Tâche suivante : '{next_task[:60]}...'")

return {
"task_queue": remaining,
"current_task": next_task,
"task_index": current_index,
"retry_count": 0,
"generated_code": None,
"execution_output": None,
"error_trace": None,
"status": "CODING",
"history": state.get("history", []) + [{
"step": "success",
"task": task,
"timestamp": datetime.now().isoformat()
}]
}
else:
self._log_step("🏁 Toutes les tâches accomplies !")
return {
"status": "DONE",
"history": state.get("history", []) + [{
"step": "completed",
"task": task,
"timestamp": datetime.now().isoformat()
}]
}

# Cas : ÉCHEC
self._log_step(f"⚠️ Échec tâche : '{task[:60]}...'")

retry_count = state.get("retry_count", 0) + 1

if retry_count >= NexusConfig.MAX_RETRIES:
self._log_step(f"🛑 Abandon après {NexusConfig.MAX_RETRIES} tentatives")

# Mémorisation de l'échec
self.memory.store_failure(task, error)

return {
"status": "FAILED",
"error_trace": f"MaxRetriesError: {NexusConfig.MAX_RETRIES} tentatives échouées\nDernière erreur: {error[:500]}",
"history": state.get("history", []) + [{
"step": "failed",
"task": task,
"error": error[:200],
"timestamp": datetime.now().isoformat()
}]
}

self._log_step(f"🔁 Tentative de correction ({retry_count}/{NexusConfig.MAX_RETRIES})")

return {
"retry_count": retry_count,
"generated_code": None,
"status": "CODING",
"history": state.get("history", []) + [{
"step": "retry",
"task": task,
"attempt": retry_count,
"timestamp": datetime.now().isoformat()
}]
}

