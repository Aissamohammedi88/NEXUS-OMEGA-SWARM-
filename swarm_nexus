class NexusMemory:
"""
Gère la mémoire à long terme via ChromaDB.
"""

def __init__(self):
self.persist_directory = NexusConfig.MEMORY_DIR
self.vector_store = None
self.embeddings = None
self._init_memory()

def _init_memory(self):
"""Initialise la connexion à ChromaDB."""
logger.info(f"Initialisation mémoire vectorielle : {self.persist_directory}")

try:
self.embeddings = OllamaEmbeddings(model=NexusConfig.EMBED_MODEL)

self.vector_store = Chroma(
collection_name="nexus_success_memory",
embedding_function=self.embeddings,
persist_directory=self.persist_directory
)

logger.info("✅ Mémoire vectorielle connectée.")

except Exception as e:
logger.error(f"Erreur d'initialisation mémoire : {e}")
logger.warning("Mode dégradé : la mémoire persistante sera désactivée.")
self.vector_store = None

def store_success(self, task: str, code: str, output: str = ""):
"""Archive une tâche réussie."""
if not self.vector_store:
logger.debug("Mémoire désactivée, ignoré.")
return

document = f"TÂCHE: {task}\n\nCODE:\n{code}\n\nSORTIE:\n{output[:500]}"

try:
self.vector_store.add_texts(
[document],
metadatas=[{
"task": task[:200],
"timestamp": datetime.now().isoformat(),
"type": "success"
}]
)
logger.info(f"💾 Tâche mémorisée : {task[:60]}...")
except Exception as e:
logger.error(f"Erreur mémorisation : {e}")

def store_failure(self, task: str, error: str):
"""Archive un échec pour apprentissage."""
if not self.vector_store:
return

document = f"ÉCHEC TÂCHE: {task}\nERREUR: {error[:500]}"

try:
self.vector_store.add_texts(
[document],
metadatas=[{
"task": task[:200],
"timestamp": datetime.now().isoformat(),
"type": "failure"
}]
)
except Exception as e:
logger.debug(f"Erreur mémorisation échec : {e}")

def retrieve_context(self, query: str, k: int = NexusConfig.MAX_MEMORY_CONTEXT) -> str:
"""Récupère le contexte pertinent."""
if not self.vector_store:
return ""

try:
docs = self.vector_store.similarity_search(query, k=k)
return "\n\n---\n\n".join([doc.page_content for doc in docs])
except Exception as e:
logger.error(f"Erreur récupération mémoire : {e}")
return ""

def get_stats(self) -> Dict[str, int]:
"""Retourne les statistiques de la mémoire."""
if not self.vector_store:
return {"count": 0, "status": "disabled"}

try:
count = self.vector_store._collection.count()
return {"count": count, "status": "active"}
except Exception:
return {"count": 0, "status": "error"}

