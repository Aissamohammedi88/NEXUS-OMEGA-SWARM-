class BaseAgent(ABC):
"""Classe abstraite pour tous les agents du swarm."""

def __init__(self, name: str, description: str = ""):
self.name = name
self.description = description
logger.info(f"Agent initialisé : {self.name}")

@abstractmethod
async def run(self, state: AgentState) -> Dict[str, Any]:
"""Point d'entrée exécuté par le graphe."""
pass

def _log_step(self, message: str, level: str = "info"):
"""Log helper."""
log_func = getattr(logger, level.lower(), logger.info)
log_func(f"[{self.name.upper()}] {message}")

