def setup_logging() -> logging.Logger:
"""
Configure un système de logging robuste avec rotation des fichiers.
"""
logger = logging.getLogger("NEXUS_OMEGA")
logger.setLevel(logging.DEBUG)

# Éviter la duplication des handlers
if logger.handlers:
return logger

# Format des logs
formatter = logging.Formatter(
'%(asctime)s | %(levelname)-8s | %(name)-15s | %(message)s',
datefmt='%Y-%m-%d %H:%M:%S'
)

# Handler console
console_handler = logging.StreamHandler(sys.stdout)
console_handler.setLevel(logging.INFO)
console_handler.setFormatter(formatter)
logger.addHandler(console_handler)

# Handler fichier rotatif
log_file = os.path.join(NexusConfig.LOG_DIR, "nexus_swarm.log")
file_handler = RotatingFileHandler(
log_file, maxBytes=10*1024*1024, backupCount=5, encoding='utf-8'
)
file_handler.setLevel(logging.DEBUG)
file_handler.setFormatter(formatter)
logger.addHandler(file_handler)

# Handler erreurs séparé
error_file = os.path.join(NexusConfig.LOG_DIR, "nexus_errors.log")
error_handler = RotatingFileHandler(
error_file, maxBytes=5*1024*1024, backupCount=3, encoding='utf-8'
)
error_handler.setLevel(logging.ERROR)
error_handler.setFormatter(formatter)
logger.addHandler(error_handler)

return logger

logger = setup_logging()

