# ═══════════════════════════════════════════════════════════════════════════════
# NEXUS OMEGA SWARM - .gitignore
# ═══════════════════════════════════════════════════════════════════════════════

# --- Environnements virtuels ---
venv/
.venv/
env/
ENV/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# --- Logs & Bases de données locales ---
logs/
*.log
nexus_memory_db/
*.sqlite
*.db
chroma.sqlite3/

# --- Sandbox d'exécution ---
sandbox/
exec_*.py

# --- Secrets & Configs ---
.env
.env.local
*.pem
*.key
config.local.json

# --- OS / IDE ---
.DS_Store
.vscode/
.idea/
*.swp

# --- Modèles LLM locaux (si présents) ---
*.gguf
*.bin
models/
